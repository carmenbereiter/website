---
import Layout from '../layouts/Layout.astro';
import ContactOptions from '../components/ContactOptions.astro';
import { getLang, useTranslations, type Lang } from '../i18n';
import { contactJsonLd } from '../lib/seo';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLang(Astro.currentLocale);
const t = useTranslations(lang);
const p = t.pages.contact;
---

<Layout lang={lang} routeKey="contact" title={p.metaTitle} description={p.metaDescription} jsonLd={contactJsonLd(lang, Astro.site)}>
  <!-- ─────────────── HERO ─────────────── -->
  <section
    class="relative mx-auto max-w-5xl px-4 pb-12 pt-6 sm:px-6 sm:pb-16 sm:pt-10 lg:px-12 lg:pb-20 lg:pt-20"
  >
    <p class="text-[11px] uppercase tracking-[0.24em] text-clay sm:text-xs sm:tracking-[0.28em]">
      {p.hero.eyebrow}
    </p>
    <h1
      class="mt-4 font-display text-[clamp(2.25rem,7vw,4.6rem)] font-normal leading-[1.05] text-ink text-balance sm:mt-6"
      style="font-variation-settings: 'opsz' 144, 'SOFT' 50;"
      set:html={p.hero.titleHtml}
    />
    <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-soft text-pretty sm:mt-6 sm:text-lg">
      {p.hero.body}
    </p>
  </section>

  <!-- ─────────────── KONTAKT-OPTIONEN ─────────────── -->
  <section class="relative">
    <div class="mx-auto max-w-3xl px-4 pb-16 sm:px-6 sm:pb-20 lg:px-12 lg:pb-24">
      <ContactOptions variant="on-cream" />
    </div>
  </section>

  <!-- ─────────────── WAS DU ERWARTEN KANNST ─────────────── -->
  <section class="relative border-t border-line bg-cream-soft/40">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-20 lg:px-12 lg:py-28">
      <div class="grid gap-10 sm:gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="text-[11px] uppercase tracking-[0.24em] text-clay sm:text-xs sm:tracking-[0.28em]">
            {p.expect.eyebrow}
          </p>
          <h2
            class="mt-4 font-display text-2xl leading-[1.15] text-ink sm:mt-6 sm:text-3xl md:text-4xl text-balance"
            style="font-variation-settings: 'opsz' 96, 'SOFT' 50;"
            set:html={p.expect.titleHtml}
          />
        </div>

        <ul class="lg:col-span-7 divide-y divide-line">
          {p.expect.steps.map((step, i) => (
            <li class="grid grid-cols-[auto_1fr] items-baseline gap-5 py-6 first:pt-0 sm:gap-8 sm:py-7">
              <span class="font-display text-xl text-clay sm:text-2xl">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3
                  class="font-display text-xl text-ink sm:text-2xl"
                  style="font-variation-settings: 'opsz' 72;"
                >
                  {step.title}
                </h3>
                <p class="mt-2 text-base leading-relaxed text-ink-soft sm:mt-3">
                  {step.body}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ─────────────── WHERE ─────────────── -->
  <section class="relative">
    <div class="mx-auto max-w-3xl px-4 py-14 text-center sm:px-6 sm:py-16 lg:px-12 lg:py-20">
      <p class="text-[11px] uppercase tracking-[0.24em] text-clay sm:text-xs sm:tracking-[0.28em]">
        {p.where.eyebrow}
      </p>
      <p
        class="mt-4 font-display text-2xl leading-[1.2] text-ink sm:mt-5 sm:text-3xl text-balance"
        style="font-variation-settings: 'opsz' 96, 'SOFT' 50;"
      >
        {t.common.locationCity}
      </p>
      <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-ink-soft sm:mt-5">
        {p.where.body}
      </p>
    </div>
  </section>
</Layout>
