---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactFAB from '../components/ContactFAB.astro';
import { site } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name}, ${site.role}`,
  description = site.description,
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F4EEE2" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/og-image.jpg', site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.jpg', site.url).href} />
    <title>{title}</title>
    {import.meta.env.PROD && (
      <script
        defer
        src="https://analytics.pulpo.cloud/script.js"
        data-website-id="a9ff2541-b307-4e33-953e-c9a2f799c27a"
      ></script>
    )}
  </head>
  <body class="bg-cream text-ink antialiased">
    <div class="bg-grain fixed inset-0 -z-10 opacity-70" aria-hidden="true"></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <ContactFAB />
  </body>
</html>
