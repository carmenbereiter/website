---
import Layout from "../layouts/Layout.astro";
import ContactOptions from "../components/ContactOptions.astro";
import { site, contact, location } from "../config";
---

<Layout title={`Kontakt · ${site.name}`}>
  <!-- ─────────────── HERO ─────────────── -->
  <section
    class="relative mx-auto max-w-5xl px-4 pb-12 pt-6 sm:px-6 sm:pb-16 sm:pt-10 lg:px-12 lg:pb-20 lg:pt-20"
  >
    <p
      class="text-[11px] uppercase tracking-[0.24em] text-clay sm:text-xs sm:tracking-[0.28em]"
    >
      Lass uns reden
    </p>
    <h1
      class="mt-4 font-display text-[clamp(2.25rem,7vw,4.6rem)] font-normal leading-[1.05] text-ink text-balance sm:mt-6"
      style="font-variation-settings: 'opsz' 144, 'SOFT' 50;"
    >
      Dein nächster Schritt ist nur eine
      <span
        class="italic text-forest"
        style="font-variation-settings: 'opsz' 144, 'SOFT' 100;">Nachricht</span
      >
      entfernt.
    </h1>
    <p
      class="mt-5 max-w-xl text-base leading-relaxed text-ink-soft text-pretty sm:mt-6 sm:text-lg"
    >
      Schreib mir kurz, was dich beschäftigt. Wir schauen gemeinsam, ob es
      passt, fachlich und menschlich. Unverbindlich und ehrlich.
    </p>
  </section>

  <!-- ─────────────── KONTAKT-OPTIONEN ─────────────── -->
  <section class="relative">
    <div
      class="mx-auto max-w-3xl px-4 pb-16 sm:px-6 sm:pb-20 lg:px-12 lg:pb-24"
    >
      <ContactOptions variant="on-cream" />

      <!-- E-Mail als zusätzlicher Kanal -->
      <div class="mt-10 border-t border-line pt-8 sm:mt-12 sm:pt-10">
        <p
          class="text-[11px] uppercase tracking-[0.24em] text-clay sm:text-xs sm:tracking-[0.28em]"
        >
          Lieber per E-Mail?
        </p>
        <p class="mt-3 text-base leading-relaxed text-ink-soft sm:text-lg">
          Klar, schreib mir an{" "}
          <a
            href={`mailto:${contact.email}`}
            class="font-display text-ink underline decoration-line decoration-1 underline-offset-[6px] transition-all hover:decoration-clay hover:underline-offset-[8px]"
            style="font-variation-settings: 'opsz' 48;"
          >
            {contact.email}
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- ─────────────── WAS DU ERWARTEN KANNST ─────────────── -->
  <section class="relative border-t border-line bg-cream-soft/40">
    <div
      class="mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-20 lg:px-12 lg:py-28"
    >
      <div class="grid gap-10 sm:gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p
            class="text-[11px] uppercase tracking-[0.24em] text-clay sm:text-xs sm:tracking-[0.28em]"
          >
            Was dich erwartet
          </p>
          <h2
            class="mt-4 font-display text-2xl leading-[1.15] text-ink sm:mt-6 sm:text-3xl md:text-4xl text-balance"
            style="font-variation-settings: 'opsz' 96, 'SOFT' 50;"
          >
            Eine ehrliche Antwort, <span class="italic text-forest"
              >persönlich</span
            > von mir.
          </h2>
        </div>

        <ul class="lg:col-span-7 divide-y divide-line">
          <li
            class="grid grid-cols-[auto_1fr] items-baseline gap-5 py-6 first:pt-0 sm:gap-8 sm:py-7"
          >
            <span class="font-display text-xl text-clay sm:text-2xl">01</span>
            <div>
              <h3
                class="font-display text-xl text-ink sm:text-2xl"
                style="font-variation-settings: 'opsz' 72;"
              >
                Du schreibst mir
              </h3>
              <p class="mt-2 text-base leading-relaxed text-ink-soft sm:mt-3">
                In wenigen Sätzen: was dich beschäftigt und wo du gerade stehst.
                Mehr brauchst du nicht.
              </p>
            </div>
          </li>
          <li
            class="grid grid-cols-[auto_1fr] items-baseline gap-5 py-6 sm:gap-8 sm:py-7"
          >
            <span class="font-display text-xl text-clay sm:text-2xl">02</span>
            <div>
              <h3
                class="font-display text-xl text-ink sm:text-2xl"
                style="font-variation-settings: 'opsz' 72;"
              >
                Ich antworte persönlich
              </h3>
              <p class="mt-2 text-base leading-relaxed text-ink-soft sm:mt-3">
                Meist noch am selben Tag. Keine Auto-Antwort, keine Vorlage,
                sondern ich.
              </p>
            </div>
          </li>
          <li
            class="grid grid-cols-[auto_1fr] items-baseline gap-5 py-6 sm:gap-8 sm:py-7"
          >
            <span class="font-display text-xl text-clay sm:text-2xl">03</span>
            <div>
              <h3
                class="font-display text-xl text-ink sm:text-2xl"
                style="font-variation-settings: 'opsz' 72;"
              >
                Wir finden einen Termin
              </h3>
              <p class="mt-2 text-base leading-relaxed text-ink-soft sm:mt-3">
                Dieser Call is dein erster Schritt zu maximaler Klarheit und der
                Grundstein für unsere gemeinsame Zusammenarbeit.
              </p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ─────────────── WHERE ─────────────── -->
  <section class="relative">
    <div
      class="mx-auto max-w-3xl px-4 py-14 text-center sm:px-6 sm:py-16 lg:px-12 lg:py-20"
    >
      <p
        class="text-[11px] uppercase tracking-[0.24em] text-clay sm:text-xs sm:tracking-[0.28em]"
      >
        Wo wir uns treffen
      </p>
      <p
        class="mt-4 font-display text-2xl leading-[1.2] text-ink sm:mt-5 sm:text-3xl text-balance"
        style="font-variation-settings: 'opsz' 96, 'SOFT' 50;"
      >
        {location.city}
      </p>
      <p
        class="mx-auto mt-4 max-w-md text-base leading-relaxed text-ink-soft sm:mt-5"
      >
        Sitzungen finden online via Zoom statt, oder vor Ort auf Gran Canaria,
        bei einem Live-Event.
      </p>
    </div>
  </section>
</Layout>
