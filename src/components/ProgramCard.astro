---
import { Icon } from 'astro-icon/components';
import { whatsappUrl, telegramUrl } from '../config';
import { getLang, useTranslations, type Program } from '../i18n';

interface Props {
  program: Program;
  index: number;
}

const { program, index } = Astro.props;
const isReversed = index % 2 === 1;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<article
  class:list={[
    'group relative grid items-center gap-8 sm:gap-10 lg:grid-cols-12 lg:gap-16',
    isReversed && 'lg:[&>.media]:order-2',
  ]}
>
  <div class="media relative lg:col-span-6">
    <div class="relative overflow-hidden rounded-[1.5rem] bg-cream-deep sm:rounded-[2rem]">
      <img
        src={program.image}
        alt={program.title}
        loading="lazy"
        decoding="async"
        class:list={[
          'aspect-[5/4] h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.03] sm:aspect-[5/4] lg:aspect-[4/5]',
          program.imagePosition === 'top' && 'object-top',
          program.imagePosition === 'bottom' && 'object-bottom',
        ]}
      />
    </div>
    <!-- Eyebrow tag overlay -->
    <div class="absolute -top-3 left-4 rounded-full bg-cream-soft px-3 py-1.5 text-[10px] uppercase tracking-[0.24em] text-clay shadow-sm sm:left-6 sm:px-4 sm:py-2 sm:tracking-[0.28em]">
      {program.eyebrow}
    </div>
  </div>

  <div class="lg:col-span-6">
    <p class="text-[11px] uppercase tracking-[0.24em] text-taupe sm:text-xs sm:tracking-[0.28em]">
      {program.subtitle}
    </p>
    <h3
      class="mt-3 font-display text-3xl leading-[1.1] text-ink sm:mt-4 sm:text-4xl md:text-5xl text-balance"
      style="font-variation-settings: 'opsz' 96, 'SOFT' 50;"
    >
      {program.title}
    </h3>
    <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-soft text-pretty sm:mt-5 sm:text-lg">
      {program.short}
    </p>

    <ul class="mt-6 space-y-3 sm:mt-7">
      {program.bullets.map((b) => (
        <li class="flex items-start gap-3 text-base text-ink-soft">
          <span class="mt-2 inline-block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-clay"></span>
          <span>{b}</span>
        </li>
      ))}
    </ul>

    <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-taupe sm:mt-8 sm:gap-x-8">
      <span><span class="text-ink-soft">{t.programCard.duration}</span> {program.duration}</span>
      <span><span class="text-ink-soft">{t.programCard.format}</span> {program.format}</span>
      <span><span class="text-ink-soft">{t.programCard.invest}</span> {program.price}</span>
    </div>

    <div class="mt-6 flex flex-col gap-3 sm:mt-8 sm:flex-row sm:flex-wrap sm:items-center">
      <a
        href={whatsappUrl(program.contactMessage)}
        target="_blank"
        rel="noopener"
        class="group/btn inline-flex w-full items-center justify-center gap-2 rounded-full bg-forest px-6 py-3.5 text-sm text-cream-soft transition-all duration-500 ease-out hover:bg-forest-deep sm:w-auto sm:hover:gap-3"
      >
        <Icon name="simple-icons:whatsapp" class="size-4" />
        <span>{t.programCard.askWhatsapp}</span>
        <Icon name="lucide:arrow-right" class="size-4 transition-transform duration-500 group-hover/btn:translate-x-0.5" />
      </a>
      <a
        href={telegramUrl()}
        target="_blank"
        rel="noopener"
        class="group/tg inline-flex w-full items-center justify-center gap-2 rounded-full border border-ink/15 bg-cream-soft px-6 py-3.5 text-sm text-ink transition-all duration-300 hover:border-[#229ED9] hover:text-[#229ED9] sm:w-auto"
      >
        <Icon name="simple-icons:telegram" class="size-4" />
        <span>{t.programCard.writeTelegram}</span>
      </a>
    </div>
  </div>
</article>
