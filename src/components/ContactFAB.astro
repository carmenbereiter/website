---
/**
 * Floatender Kontakt-Stack — immer rechts unten sichtbar.
 * Jeder Button öffnet den Kanal direkt (kein Formular).
 */
import { Icon } from 'astro-icon/components';
import { contact, whatsappUrl } from '../config';
---

<div class="fab fixed bottom-4 right-4 z-40 flex flex-col items-end gap-2.5 sm:bottom-7 sm:right-7 sm:gap-3">
  <a
    href={contact.calendly.url}
    target="_blank"
    rel="noopener"
    aria-label="Erstgespräch buchen (Calendly)"
    class="fab-btn group order-3"
    style="background: var(--color-forest); color: var(--color-cream-soft);"
  >
    <span class="fab-tip">Termin buchen</span>
    <Icon name="lucide:calendar" class="size-5" />
  </a>

  <a
    href={contact.telegram.url}
    target="_blank"
    rel="noopener"
    aria-label="Auf Telegram schreiben"
    class="fab-btn group order-2"
    style="background: #229ED9; color: white;"
  >
    <span class="fab-tip">Telegram</span>
    <Icon name="simple-icons:telegram" class="size-5" />
  </a>

  <a
    href={whatsappUrl()}
    target="_blank"
    rel="noopener"
    aria-label="Auf WhatsApp schreiben"
    class="fab-btn group order-1 fab-pulse"
    style="background: #25D366; color: white;"
  >
    <span class="fab-tip">WhatsApp</span>
    <Icon name="simple-icons:whatsapp" class="size-6" />
  </a>
</div>

<style>
  .fab-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 9999px;
    box-shadow:
      0 10px 30px -6px rgba(26, 31, 29, 0.28),
      0 4px 10px -2px rgba(26, 31, 29, 0.12);
    transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 350ms cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
  }

  @media (min-width: 640px) {
    .fab-btn { width: 52px; height: 52px; }
  }

  .fab-btn:hover {
    transform: translateY(-3px) scale(1.04);
    box-shadow:
      0 14px 38px -6px rgba(26, 31, 29, 0.36),
      0 6px 14px -2px rgba(26, 31, 29, 0.18);
  }

  /* Tooltips nur auf Geräten mit echtem Hover (Desktop) anzeigen */
  .fab-tip {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .fab-tip {
      display: block;
      position: absolute;
      right: calc(100% + 12px);
      top: 50%;
      transform: translateY(-50%) translateX(6px);
      background: var(--color-ink);
      color: var(--color-cream-soft);
      padding: 6px 12px;
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 500;
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      transition: all 300ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .fab-btn:hover .fab-tip {
      opacity: 1;
      transform: translateY(-50%) translateX(0);
    }
  }

  /* Sanfter Puls auf dem primären (WhatsApp) Button */
  @keyframes fab-pulse-ring {
    0% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.45); }
    70% { box-shadow: 0 0 0 14px rgba(37, 211, 102, 0); }
    100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
  }

  .fab-pulse {
    animation: fab-pulse-ring 2.4s ease-out infinite;
  }
</style>
