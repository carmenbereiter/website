---
/**
 * Drei Kontakt-Kacheln: WhatsApp · Telegram · Calendly.
 * Wiederverwendet auf der /kontakt-Seite und am Ende der Startseite.
 */
import { Icon } from 'astro-icon/components';
import { contact, whatsappUrl } from '../config';

interface Props {
  /** Hintergrund-Variante der Kacheln */
  variant?: 'on-forest' | 'on-cream';
}

const { variant = 'on-forest' } = Astro.props;

const tileClasses =
  variant === 'on-forest'
    ? 'group flex items-center justify-between gap-3 rounded-2xl bg-cream-soft px-5 py-4 text-ink transition-all hover:bg-clay-soft sm:gap-4 sm:px-6 sm:py-5'
    : 'group flex items-center justify-between gap-3 rounded-2xl border border-line bg-cream-soft px-5 py-4 text-ink transition-all hover:border-forest hover:bg-cream-deep sm:gap-4 sm:px-6 sm:py-5';
---

<div class="space-y-3">
  <a
    href={whatsappUrl()}
    target="_blank"
    rel="noopener"
    class={tileClasses}
  >
    <div class="flex items-center gap-3 sm:gap-4">
      <span class="inline-flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full" style="background: #25D366; color: white;">
        <Icon name="simple-icons:whatsapp" class="size-[22px]" />
      </span>
      <div class="min-w-0">
        <div class="font-display text-lg leading-tight sm:text-xl" style="font-variation-settings: 'opsz' 72;">WhatsApp</div>
        <div class="text-xs text-taupe sm:text-sm">Persönlich. Schnell. Direkt zu mir.</div>
      </div>
    </div>
    <Icon name="lucide:arrow-right" class="size-5 flex-shrink-0 transition-transform group-hover:translate-x-1 sm:size-6" />
  </a>

  <a
    href={contact.telegram.url}
    target="_blank"
    rel="noopener"
    class={tileClasses}
  >
    <div class="flex items-center gap-3 sm:gap-4">
      <span class="inline-flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full" style="background: #229ED9; color: white;">
        <Icon name="simple-icons:telegram" class="size-[22px]" />
      </span>
      <div class="min-w-0">
        <div class="font-display text-lg leading-tight sm:text-xl" style="font-variation-settings: 'opsz' 72;">Telegram</div>
        <div class="truncate text-xs text-taupe sm:text-sm">@{contact.telegram.handle}</div>
      </div>
    </div>
    <Icon name="lucide:arrow-right" class="size-5 flex-shrink-0 transition-transform group-hover:translate-x-1 sm:size-6" />
  </a>

  <a
    href={contact.calendly.url}
    target="_blank"
    rel="noopener"
    class={tileClasses}
  >
    <div class="flex items-center gap-3 sm:gap-4">
      <span class="inline-flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-forest text-cream-soft">
        <Icon name="lucide:calendar" class="size-[22px]" />
      </span>
      <div class="min-w-0">
        <div class="font-display text-lg leading-tight sm:text-xl" style="font-variation-settings: 'opsz' 72;">Erstgespräch buchen</div>
        <div class="text-xs text-taupe sm:text-sm">online</div>
      </div>
    </div>
    <Icon name="lucide:arrow-right" class="size-5 flex-shrink-0 transition-transform group-hover:translate-x-1 sm:size-6" />
  </a>
</div>
