---
import { site, contact, nav, location, whatsappUrl } from '../config';
const year = new Date().getFullYear();
---

<footer class="relative border-t border-line bg-cream-soft/40">
  <div class="mx-auto max-w-7xl px-4 pb-24 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-12 lg:py-20">
    <div class="grid gap-10 sm:gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3">
          <img
            src="/images/Carmen_Taube-300x265.webp"
            alt=""
            width="44"
            height="40"
            class="h-10 w-auto"
            aria-hidden="true"
          />
          <div>
            <div class="font-display text-2xl text-ink" style="font-variation-settings: 'opsz' 72;">
              {site.name}
            </div>
            <div class="text-xs uppercase tracking-[0.24em] text-taupe">{site.role}</div>
          </div>
        </div>
        <p class="mt-6 max-w-md text-base leading-relaxed text-ink-soft">
          {site.description}
        </p>
        <p class="mt-4 text-sm text-taupe">{location.city}</p>
      </div>

      <div class="lg:col-span-3">
        <div class="text-xs uppercase tracking-[0.24em] text-clay">Navigation</div>
        <ul class="mt-5 space-y-3">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="text-ink-soft transition-colors hover:text-forest">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-4">
        <div class="text-xs uppercase tracking-[0.24em] text-clay">Direkt erreichen</div>
        <ul class="mt-5 space-y-3">
          <li>
            <a
              href={whatsappUrl()}
              target="_blank"
              rel="noopener"
              class="group inline-flex items-center gap-2 text-ink-soft transition-colors hover:text-forest"
            >
              <span class="font-display text-lg" style="font-variation-settings: 'opsz' 48;">WhatsApp</span>
              <span aria-hidden class="transition-transform group-hover:translate-x-1">→</span>
            </a>
          </li>
          <li>
            <a
              href={contact.telegram.url}
              target="_blank"
              rel="noopener"
              class="group inline-flex items-center gap-2 text-ink-soft transition-colors hover:text-forest"
            >
              <span class="font-display text-lg" style="font-variation-settings: 'opsz' 48;">Telegram</span>
              <span aria-hidden class="transition-transform group-hover:translate-x-1">→</span>
            </a>
          </li>
          <li>
            <a
              href={contact.calendly.url}
              target="_blank"
              rel="noopener"
              class="group inline-flex items-center gap-2 text-ink-soft transition-colors hover:text-forest"
            >
              <span class="font-display text-lg" style="font-variation-settings: 'opsz' 48;">Termin online buchen</span>
              <span aria-hidden class="transition-transform group-hover:translate-x-1">→</span>
            </a>
          </li>
          <li>
            <a
              href={`mailto:${contact.email}`}
              class="text-sm text-taupe transition-colors hover:text-forest"
            >
              {contact.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-start justify-between gap-4 border-t border-line pt-8 text-sm text-taupe sm:flex-row sm:items-center">
      <div>© {year} {site.name}. Mit Liebe gemacht.</div>
      <div class="flex items-center gap-6">
        <a href="/aviso-legal" class="hover:text-forest">Aviso Legal</a>
        <a href="/politica-de-privacidad" class="hover:text-forest">Política de Privacidad</a>
      </div>
    </div>
  </div>
</footer>
