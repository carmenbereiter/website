---
import { site, contact, whatsappUrl } from '../config';
import { getLang, useTranslations, getNav, legalRoutes } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const nav = getNav(lang);
const year = new Date().getFullYear();
const waUrl = whatsappUrl(t.common.whatsappDefault);
// Rechtstext-Pfade je Sprache zentral aus i18n; Labels in der Seitensprache.
// Die spanische Fassung ist rechtlich maßgeblich (Sitz in Spanien); DE/EN sind
// Übersetzungen zur besseren Verständlichkeit.
const legalLabels = {
  de: { notice: 'Impressum', privacy: 'Datenschutz' },
  en: { notice: 'Legal Notice', privacy: 'Privacy Policy' },
  es: { notice: 'Aviso Legal', privacy: 'Política de Privacidad' },
}[lang];
---

<footer class="relative border-t border-line bg-cream-soft/40">
  <div class="mx-auto max-w-7xl px-4 pb-24 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-12 lg:py-20">
    <div class="grid gap-10 sm:gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3">
          <img
            src="/logo.webp"
            alt=""
            width="44"
            height="40"
            class="h-10 w-auto"
            aria-hidden="true"
          />
          <div>
            <div class="font-display text-2xl text-ink" style="font-variation-settings: 'opsz' 72;">
              {site.name}
            </div>
            <div class="text-xs uppercase tracking-[0.24em] text-taupe">{t.site.role}</div>
          </div>
        </div>
        <p class="mt-6 max-w-md text-base leading-relaxed text-ink-soft">
          {t.site.description}
        </p>
        <p class="mt-4 text-sm text-taupe">{t.common.locationCity}</p>
      </div>

      <div class="lg:col-span-3">
        <div class="text-xs uppercase tracking-[0.24em] text-clay">{t.footer.navHeading}</div>
        <ul class="mt-5 space-y-3">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="text-ink-soft transition-colors hover:text-forest">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-4">
        <div class="text-xs uppercase tracking-[0.24em] text-clay">{t.footer.directHeading}</div>
        <ul class="mt-5 space-y-3">
          <li>
            <a
              href={waUrl}
              target="_blank"
              rel="noopener"
              class="group inline-flex items-center gap-2 text-ink-soft transition-colors hover:text-forest"
            >
              <span class="font-display text-lg" style="font-variation-settings: 'opsz' 48;">WhatsApp</span>
              <span aria-hidden class="transition-transform group-hover:translate-x-1">→</span>
            </a>
          </li>
          <li>
            <a
              href={contact.calendly.url}
              target="_blank"
              rel="noopener"
              class="group inline-flex items-center gap-2 text-ink-soft transition-colors hover:text-forest"
            >
              <span class="font-display text-lg" style="font-variation-settings: 'opsz' 48;">{t.footer.bookOnline}</span>
              <span aria-hidden class="transition-transform group-hover:translate-x-1">→</span>
            </a>
          </li>
          <li>
            <a
              href={`mailto:${contact.email}`}
              class="text-sm text-taupe transition-colors hover:text-forest"
            >
              {contact.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-start justify-between gap-4 border-t border-line pt-8 text-sm text-taupe sm:flex-row sm:items-center">
      <div>© {year} {site.name}. {t.footer.rights}</div>
      <div class="flex items-center gap-6">
        <a href={legalRoutes.notice[lang]} class="hover:text-forest">{legalLabels.notice}</a>
        <a href={legalRoutes.privacy[lang]} class="hover:text-forest">{legalLabels.privacy}</a>
      </div>
    </div>
  </div>
</footer>
