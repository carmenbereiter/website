---
import { Icon } from 'astro-icon/components';
import { site, contact, whatsappUrl } from '../config';
import {
  getLang,
  useTranslations,
  getNav,
  getLangSwitch,
  matchRoute,
  localizedPath,
} from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const nav = getNav(lang);
const routeKey = matchRoute(Astro.url.pathname, lang);
const langs = getLangSwitch(routeKey, lang);
const homeHref = localizedPath('home', lang);
const waUrl = whatsappUrl(t.common.whatsappDefault);
---

<header class="relative z-30 mx-auto flex max-w-7xl items-center justify-between px-4 pt-4 sm:px-6 sm:pt-6 lg:px-12 lg:pt-8">
  <a href={homeHref} class="group flex items-center gap-2.5 sm:gap-3">
    <img
      src="/images/Carmen_Taube-300x265.webp"
      alt=""
      width="56"
      height="50"
      class="h-16 w-auto sm:h-20"
      aria-hidden="true"
    />
    <div class="leading-tight">
      <div class="font-display text-lg text-ink sm:text-xl" style="font-variation-settings: 'opsz' 72;">
        {site.name}
      </div>
      <div class="hidden text-[10px] uppercase tracking-[0.24em] text-taupe sm:block">
        {t.site.role}
      </div>
    </div>
  </a>

  <!-- Desktop nav -->
  <nav class="hidden items-center gap-1 text-sm text-ink-soft md:flex md:gap-4">
    {nav.map((item) => (
      <a
        href={item.href}
        class="rounded-full px-3 py-2 transition-colors hover:text-forest"
      >
        {item.label}
      </a>
    ))}

    <!-- Sprachumschalter (Globus-Dropdown) -->
    <div class="relative ml-1">
      <button
        id="lang-toggle"
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="lang-menu"
        aria-label={t.header.langLabel}
        class="group inline-flex items-center gap-1.5 rounded-full px-2.5 py-2 text-ink-soft transition-colors hover:bg-cream-soft hover:text-forest aria-expanded:bg-cream-soft"
      >
        <Icon name="lucide:globe" class="size-4 text-taupe transition-colors group-hover:text-forest" />
        <span class="text-[11px] font-medium uppercase tracking-[0.12em]">{lang}</span>
        <Icon name="lucide:chevron-down" class="size-3.5 text-taupe transition-transform duration-300 group-aria-expanded:rotate-180" />
      </button>

      <div
        id="lang-menu"
        role="menu"
        aria-label={t.header.langLabel}
        class="absolute right-0 top-full z-40 mt-2 hidden min-w-[10rem] rounded-2xl border border-line bg-cream-soft p-1.5 shadow-[0_16px_44px_-16px_rgba(26,31,29,0.32)]"
      >
        {langs.map((l) => (
          <a
            href={l.href}
            hreflang={l.lang}
            role="menuitem"
            aria-current={l.isCurrent ? 'true' : undefined}
            class:list={[
              'flex items-center justify-between gap-4 rounded-xl px-3 py-2 text-sm transition-colors',
              l.isCurrent
                ? 'bg-cream-deep font-medium text-forest'
                : 'text-ink-soft hover:bg-cream-deep hover:text-forest',
            ]}
          >
            <span>{l.label}</span>
            {l.isCurrent ? (
              <Icon name="lucide:check" class="size-4 text-clay" />
            ) : (
              <span class="text-[10px] uppercase tracking-[0.12em] text-taupe">{l.lang}</span>
            )}
          </a>
        ))}
      </div>
    </div>

    <a
      href={waUrl}
      target="_blank"
      rel="noopener"
      class="group inline-flex items-center gap-2 rounded-full border border-ink/15 bg-cream-soft px-4 py-2 text-sm text-ink transition-all duration-300 hover:border-forest hover:bg-forest hover:text-cream-soft"
    >
      <Icon name="simple-icons:whatsapp" class="size-4" />
      <span>{t.header.writeMe}</span>
    </a>
  </nav>

  <!-- Mobile hamburger button -->
  <button
    id="nav-toggle"
    type="button"
    aria-label={t.header.menuOpen}
    aria-expanded="false"
    aria-controls="mobile-nav"
    class="group relative -mr-1 inline-flex h-11 w-11 items-center justify-center rounded-full border border-ink/15 bg-cream-soft text-ink transition-colors hover:border-forest md:hidden"
  >
    <span class="sr-only">{t.header.menuOpen}</span>
    <!-- Animated hamburger / X icon -->
    <span class="block h-4 w-5 relative" aria-hidden="true">
      <span class="absolute left-0 top-[3px] block h-[1.5px] w-5 bg-current transition-transform duration-300 ease-out group-aria-expanded:translate-y-[5px] group-aria-expanded:rotate-45"></span>
      <span class="absolute left-0 top-[8px] block h-[1.5px] w-5 bg-current transition-opacity duration-200 group-aria-expanded:opacity-0"></span>
      <span class="absolute left-0 top-[13px] block h-[1.5px] w-5 bg-current transition-transform duration-300 ease-out group-aria-expanded:-translate-y-[5px] group-aria-expanded:-rotate-45"></span>
    </span>
  </button>
</header>

<!-- Mobile menu overlay + panel -->
<div
  id="mobile-nav"
  aria-hidden="true"
  class="fixed inset-0 z-50 hidden md:hidden"
>
  <!-- Backdrop -->
  <div
    id="nav-backdrop"
    class="absolute inset-0 bg-ink/40 opacity-0 transition-opacity duration-300"
  ></div>

  <!-- Panel -->
  <aside
    class="absolute right-0 top-0 flex h-full w-full max-w-[400px] translate-x-full flex-col bg-cream shadow-2xl transition-transform duration-300 ease-out"
    id="nav-panel"
  >
    <div class="flex items-center justify-between px-5 pt-5">
      <a href={homeHref} class="flex items-center gap-2.5">
        <img
          src="/images/Carmen_Taube-300x265.webp"
          alt=""
          class="h-11 w-auto"
          aria-hidden="true"
        />
        <div class="leading-tight">
          <div class="font-display text-lg text-ink" style="font-variation-settings: 'opsz' 72;">
            {site.name}
          </div>
          <div class="text-[10px] uppercase tracking-[0.24em] text-taupe">
            {t.site.role}
          </div>
        </div>
      </a>
      <button
        id="nav-close"
        type="button"
        aria-label={t.header.menuClose}
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-ink/15 bg-cream-soft text-ink transition-colors hover:border-forest"
      >
        <Icon name="lucide:x" class="size-5" />
      </button>
    </div>

    <!-- Nav links -->
    <nav class="flex-1 overflow-y-auto px-5 pt-6">
      <ul class="space-y-0.5">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link group flex items-center justify-between gap-4 rounded-2xl px-4 py-2.5 font-display text-xl text-ink transition-colors hover:bg-cream-soft"
              style="font-variation-settings: 'opsz' 72;"
            >
              <span>{item.label}</span>
              <Icon name="lucide:arrow-up-right" class="size-5 text-taupe transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-forest" />
            </a>
          </li>
        ))}
      </ul>

      <!-- Divider -->
      <div class="my-5 border-t border-line"></div>

      <!-- Direct contact: kompakte Dreierreihe -->
      <p class="px-4 text-[11px] uppercase tracking-[0.24em] text-clay">{t.header.directContact}</p>
      <div class="mt-3 grid grid-cols-2 gap-2">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener"
          class="flex flex-col items-center justify-center gap-2 rounded-2xl bg-forest px-2 py-4 text-center text-cream-soft transition-colors hover:bg-forest-deep"
        >
          <Icon name="simple-icons:whatsapp" class="size-6" />
          <span class="text-xs leading-tight">WhatsApp</span>
        </a>

        <a
          href={contact.calendly.url}
          target="_blank"
          rel="noopener"
          class="flex flex-col items-center justify-center gap-2 rounded-2xl border border-line bg-cream-soft px-2 py-4 text-center text-ink transition-colors hover:border-forest hover:text-forest"
        >
          <Icon name="lucide:calendar" class="size-6" />
          <span class="text-xs leading-tight">{t.header.bookTitle}</span>
        </a>
      </div>
    </nav>

    <!-- Footer in menu: E-Mail + Sprachauswahl ganz unten -->
    <div class="flex items-center justify-between gap-4 border-t border-line px-5 py-2.5">
      <a
        href={`mailto:${contact.email}`}
        class="truncate text-xs text-taupe transition-colors hover:text-forest"
      >
        {contact.email}
      </a>
      <div class="flex flex-shrink-0 items-center gap-2">
        <Icon name="lucide:globe" class="size-4 text-taupe" aria-label={t.header.langLabel} />
        <div class="flex items-center gap-1 text-sm uppercase tracking-[0.14em]">
          {langs.map((l, i) => (
            <Fragment>
              {i > 0 && <span aria-hidden="true" class="text-line">·</span>}
              <a
                href={l.href}
                hreflang={l.lang}
                aria-current={l.isCurrent ? 'true' : undefined}
                class:list={[
                  'inline-flex min-h-11 items-center rounded-lg px-3 transition-colors',
                  l.isCurrent
                    ? 'font-medium text-forest'
                    : 'text-taupe hover:text-forest',
                ]}
              >
                {l.lang}
              </a>
            </Fragment>
          ))}
        </div>
      </div>
    </div>
  </aside>
</div>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  const backdrop = document.getElementById('nav-backdrop');
  const drawer = document.getElementById('nav-panel');
  const closeBtn = document.getElementById('nav-close');

  if (!toggle || !panel || !backdrop || !drawer || !closeBtn) {
    // Elemente fehlen, kein Setup nötig
  } else {
    const open = () => {
      panel.classList.remove('hidden');
      panel.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      // Nächster Frame: Transitions triggern
      requestAnimationFrame(() => {
        backdrop.classList.remove('opacity-0');
        backdrop.classList.add('opacity-100');
        drawer.classList.remove('translate-x-full');
      });
    };

    const close = () => {
      backdrop.classList.add('opacity-0');
      backdrop.classList.remove('opacity-100');
      drawer.classList.add('translate-x-full');
      toggle.setAttribute('aria-expanded', 'false');
      // Nach Transition: ausblenden
      setTimeout(() => {
        panel.classList.add('hidden');
        panel.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }, 300);
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? close() : open();
    });

    closeBtn.addEventListener('click', close);
    backdrop.addEventListener('click', close);

    // Schließen bei ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        close();
      }
    });

    // Schließen wenn ein Nav-Link geklickt wird (Anchor-Navigation auf gleicher Seite)
    panel.querySelectorAll('.nav-link').forEach((link) => {
      link.addEventListener('click', close);
    });
  }

  // Sprach-Dropdown (Desktop)
  const langToggle = document.getElementById('lang-toggle');
  const langMenu = document.getElementById('lang-menu');

  if (langToggle && langMenu) {
    const closeLang = () => {
      langToggle.setAttribute('aria-expanded', 'false');
      langMenu.classList.add('hidden');
    };
    const openLang = () => {
      langToggle.setAttribute('aria-expanded', 'true');
      langMenu.classList.remove('hidden');
    };

    langToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      langToggle.getAttribute('aria-expanded') === 'true' ? closeLang() : openLang();
    });

    // Klick außerhalb schließt
    document.addEventListener('click', (e) => {
      if (!langMenu.contains(e.target as Node) && !langToggle.contains(e.target as Node)) {
        closeLang();
      }
    });

    // ESC schließt
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLang();
    });
  }
</script>
